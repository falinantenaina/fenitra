# ── Serveur ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# ── Base de données ─────────────────────────────────────
# PostgreSQL. Ne JAMAIS committer un vrai .env.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/gestion_vente?schema=public
# Base utilisée par la suite de tests (reset automatique à chaque run)
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/gestion_vente_test?schema=public

# ── Authentification ────────────────────────────────────
# Générer avec : openssl rand -hex 64
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long-please
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── CORS ────────────────────────────────────────────────
CORS_ORIGINS=*

# ── Sessions / pagination ───────────────────────────────
ACCESS_TOKEN_MAX_AGE_SECONDS=900
REFRESH_TOKEN_MAX_AGE_SECONDS=2592000
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# ── Business ────────────────────────────────────────────
BUSINESS_CURRENCY=Ariary
BUSINESS_TIMEZONE=Indian/Antananarivo
# Solde de caisse au démarrage de l'activité (si aucune écriture antérieure)
OPENING_CASH_BALANCE=0
